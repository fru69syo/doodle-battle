  "patterns": [
    {
      "id": "digits_run",
      "category": "personal_info",
      "regex": "[0-9]{6,}",
      "description": "6+ consecutive digits after separators are removed (phone numbers, postal codes, IDs)"
    },
    {
      "id": "postal_mark",
      "category": "personal_info",
      "regex": "〒",
      "description": "Japanese postal code mark"
    },
    {
      "id": "url_scheme",
      "category": "personal_info",
      "regex": "(https?|ftp)[:：]",
      "description": "URL scheme"
    },
    {
      "id": "www",
      "category": "personal_info",
      "regex": "www[.]",
      "description": "www. prefix"
    },
    {
      "id": "domain",
      "category": "personal_info",
      "regex": "[a-z0-9][.](com|net|org|jp|io|me|tv|app|xyz|info|co|ly|gg|link|site)(?![a-z])",
      "description": "domain name"
    },
    {
      "id": "email",
      "category": "personal_info",
      "regex": "[a-z0-9._+]@[a-z0-9]",
      "description": "email address"
    },
    {
      "id": "handle",
      "category": "personal_info",
      "regex": "^@[a-z0-9_]{2,}",
      "description": "SNS handle"
    }
  ],
